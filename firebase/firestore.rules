rules_version = '2';

// Registro presenze & ferie (v6): ogni utente legge e scrive solo il proprio documento
// users/{uid}. Tutto il resto del database è chiuso.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'rev', 'by', 'app', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000
        && request.resource.data.rev is int;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
